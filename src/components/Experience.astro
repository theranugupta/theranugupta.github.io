---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-6 py-16 sm:px-8 md:px-16 md:py-20 lg:px-24 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
            Experience
          </p>
          <h2 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">
            Building product teams and platforms through strong engineering practice
          </h2>
          <div
            class="mt-4 h-[5px] w-[75px] rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        <div class="mt-10 space-y-6">
          {siteConfig.experience.map((exp) => (
            <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900">{exp.title}</h3>
                  <p class="mt-1 text-lg font-medium" style={{ color: siteConfig.accentColor }}>
                    {exp.company}
                  </p>
                </div>
                <span class="text-sm text-gray-500">{exp.dateRange}</span>
              </div>

              <ul class="mt-5 space-y-3">
                {exp.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 text-sm leading-7 text-gray-600 sm:text-base">
                    <span class="mt-2.5 h-2.5 w-2.5 rounded-full" style={{ backgroundColor: siteConfig.accentColor }} />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
