---
import { siteConfig } from "../config";

const navLinks = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Education", href: "#education" },
  { label: "Achievements", href: "#achievements" },
  { label: "Interests", href: "#interests" },
  { label: "Resume", href: "#resume" },
  { label: "Contact", href: "#contact" },
];
const firstName = siteConfig.name.split(" ")[0];
---

<header
  id="header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent py-3 transition-all duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-6 sm:px-8">
    <a
      id="nav-brand"
      href="/"
      class="mr-auto inline-flex items-center gap-2 text-lg font-bold text-gray-900"
    >
      <span
        class="font-mono"
        style={`color: ${siteConfig.accentColorStrong}`}>{"</>"}</span
      >
      <span>{firstName}</span>
    </a>

    <nav
      id="nav-links"
      class="pointer-events-none absolute left-4 right-4 top-16 flex -translate-y-2 flex-col gap-1 rounded-2xl border border-gray-200 bg-white p-3 opacity-0 shadow-lg transition-all duration-150 lg:pointer-events-auto lg:static lg:translate-y-0 lg:flex-row lg:items-center lg:gap-6 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0 lg:opacity-100 lg:shadow-none"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="relative rounded-xl px-3 py-2.5 text-sm font-medium text-gray-600 transition-colors hover:bg-[var(--accent-soft)] hover:text-[var(--accent-strong)] lg:rounded-none lg:bg-transparent lg:p-0 lg:hover:bg-transparent lg:hover:text-[var(--accent-strong)] lg:after:absolute lg:after:-bottom-1.5 lg:after:left-0 lg:after:h-0.5 lg:after:w-0 lg:after:rounded-full lg:after:bg-[linear-gradient(90deg,var(--accent),var(--accent-strong))] lg:after:transition-[width] lg:after:duration-300 lg:hover:after:w-full"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="mt-2 inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-[0_8px_24px_var(--accent-glow)] transition hover:-translate-y-0.5 lg:ml-2 lg:mt-0"
        style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.accentColorStrong})`}
      >
        Hire Me
      </a>
    </nav>

    <button
      id="nav-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="flex h-10 w-10 flex-col items-center justify-center gap-[5px] rounded-[10px] border border-gray-300 bg-white lg:hidden"
    >
      <span class="block h-0.5 w-[18px] rounded bg-gray-900"></span>
      <span class="block h-0.5 w-[18px] rounded bg-gray-900"></span>
      <span class="block h-0.5 w-[18px] rounded bg-gray-900"></span>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById("header");
  const onScroll = () => {
    if (window.scrollY > 30) {
      header?.classList.add(
        "bg-white/85",
        "backdrop-blur-md",
        "border-gray-200",
        "shadow-[0_6px_24px_rgba(193,73,58,0.08)]"
      );
    } else {
      header?.classList.remove(
        "bg-white/85",
        "backdrop-blur-md",
        "border-gray-200",
        "shadow-[0_6px_24px_rgba(193,73,58,0.08)]"
      );
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll);

  const brand = document.getElementById("nav-brand");
  brand?.addEventListener("click", (e) => {
    e.preventDefault();
    history.replaceState(null, "", window.location.pathname);
    window.location.reload();
  });

  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");
  const openClasses = ["pointer-events-auto", "translate-y-0", "opacity-100"];
  const closeMenu = () => {
    links?.classList.remove(...openClasses);
    toggle?.setAttribute("aria-expanded", "false");
  };
  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.contains("opacity-100");
    if (isOpen) {
      closeMenu();
    } else {
      links?.classList.add(...openClasses);
      toggle?.setAttribute("aria-expanded", "true");
    }
  });
  links?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", closeMenu);
  });
</script>
