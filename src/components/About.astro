---
import { siteConfig } from "../config";
---

<section id="about" class="px-6 py-16 sm:px-8 md:px-16 md:py-20 lg:px-24 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
          About me
        </p>
        <h2 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">
          Building thoughtful products with a strong engineering foundation
        </h2>
        <div
          class="mt-4 h-[5px] w-[75px] rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
      </div>

      <div class="space-y-6">
        {
          siteConfig.aboutMe.map((paragraph) => (
            <p class="text-lg leading-8 text-gray-600 sm:text-xl">
              {paragraph}
            </p>
          ))
        }

        <div class="pt-4 space-y-6">
          {
            siteConfig.skills.map((group) => (
              <div>
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-widest text-gray-500">
                  {group.category}
                </h3>
                <div class="flex flex-wrap gap-3">
                  {group.items.map((skill) => (
                    <span class="rounded-full bg-white px-3 py-2 text-sm font-medium text-gray-700 shadow-sm ring-1 ring-gray-200 transition hover:-translate-y-0.5">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
