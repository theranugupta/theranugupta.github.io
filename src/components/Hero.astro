---
import { siteConfig } from "../config";

const [role, company] = siteConfig.title.split(" @ ");
const about = siteConfig.aboutMe.join(" ");
const code = `const developer = {
  name: 'Ranu Gupta',
  role: 'Senior Front-end Dev',
  stack: [
    'React', 'Redux',
    'TypeScript', 'Next.js'
  ],
  yearsOfExperience: 9,
  loves: ['clean code', 'a11y'],
  shipping: true,
};`;
---

<section id="hero" class="relative isolate overflow-hidden pt-32 pb-16 md:pt-36">
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-6 sm:px-8 lg:grid-cols-[1.1fr_0.9fr]"
  >
    <div>
      <span
        class="inline-block rounded-full border border-gray-300 px-3.5 py-1.5 text-[13px] font-semibold"
        style={`background-color: var(--accent-soft); color: ${siteConfig.accentColorStrong}`}
      >
        Hello! 👋
      </span>
      <h1
        class="mt-5 text-[clamp(32px,5vw,56px)] font-extrabold leading-[1.15] tracking-[-0.03em] text-gray-900"
      >
        I'm <span class="gradient-text">{siteConfig.name}</span>,<br />
        {role}<br />
        <span class="font-semibold text-gray-600">@ {company}</span>
      </h1>
      <p
        class="mt-4 font-mono font-semibold"
        style={`color: ${siteConfig.accentColorStrong}`}
      >
        {siteConfig.subtitle}
      </p>
      <p class="mt-4 max-w-[560px] leading-7 text-gray-600">{about}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold text-white shadow-[0_8px_24px_var(--accent-glow)] transition hover:-translate-y-0.5"
          style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, ${siteConfig.accentColorStrong})`}
        >
          View My Work
        </a>
        <a
          href={siteConfig.resume?.url}
          download
          class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-900 transition hover:-translate-y-0.5 hover:border-[var(--accent)] hover:text-[var(--accent-strong)]"
        >
          <span aria-hidden="true">⬇</span> Download Resume
        </a>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end" aria-hidden="true">
      <div
        class="w-full max-w-[440px] overflow-hidden rounded-2xl border border-[#3a2419] shadow-[0_30px_60px_rgba(193,73,58,0.22),inset_0_0_0_1px_rgba(224,120,86,0.2)]"
        style="background: linear-gradient(180deg, #2a1a14, #1a100c)"
      >
        <div
          class="flex items-center gap-1.5 border-b border-white/10 bg-black/25 px-3.5 py-3"
        >
          <span class="h-3 w-3 rounded-full bg-[#ff6b6b]"></span>
          <span class="h-3 w-3 rounded-full bg-[#f0a085]"></span>
          <span class="h-3 w-3 rounded-full bg-[#e9d49a]"></span>
          <span class="ml-auto font-mono text-xs text-[#f5dccc]"
            >ranu.profile.ts</span
          >
        </div>
        <pre
          class="m-0 overflow-x-auto p-5 font-mono text-sm leading-7 text-[#fdeee5]">{code}</pre>
      </div>
    </div>
  </div>
</section>
