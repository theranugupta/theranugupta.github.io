---
import { siteConfig } from "../config";

const hasInterests = siteConfig.interests && siteConfig.interests.length > 0;
const hasRepos = siteConfig.githubProjects && siteConfig.githubProjects.length > 0;
---

{
  hasInterests && (
    <section id="interests" class="bg-gray-50 px-6 py-16 sm:px-8 md:px-16 md:py-20 lg:px-24 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
            Beyond work
          </p>
          <h2 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">
            Interests that keep the craft fresh
          </h2>
          <div class="mt-4 h-[5px] w-[75px] rounded-full" style={{ backgroundColor: siteConfig.accentColor }} />
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {siteConfig.interests.map((interest) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
              <div class="text-2xl" aria-hidden="true">{interest.icon}</div>
              <h3 class="mt-4 text-lg font-semibold text-gray-900">{interest.title}</h3>
              <p class="mt-2 text-sm leading-7 text-gray-600">{interest.description}</p>
            </div>
          ))}
        </div>

        {hasRepos && (
          <div id="github" class="mt-14">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <h3 class="text-lg font-semibold uppercase tracking-widest text-gray-500">
                Building in public on GitHub
              </h3>
              <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="font-medium" style={{ color: siteConfig.accentColor }}>
                @theranugupta ↗
              </a>
            </div>
            <p class="mt-3 text-base text-gray-600">
              Side projects and learning sandboxes — open source and live on GitHub.
            </p>

            <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {siteConfig.githubProjects.map((repo) => (
                <a href={repo.repoUrl} target="_blank" rel="noopener noreferrer" class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-sm" style={{ color: siteConfig.accentColor }} aria-hidden="true">{"</>"}</span>
                    <h4 class="text-base font-semibold text-gray-900">{repo.name}</h4>
                  </div>
                  <p class="mt-4 text-sm leading-7 text-gray-600">{repo.description}</p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    {repo.tech.map((t) => (
                      <span class="rounded-full bg-gray-900 px-2.5 py-1 text-xs font-medium text-white">{t}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}
