---
import { siteConfig } from "../config";

const { awards, metrics, softSkills } = siteConfig.achievements;
---

<section id="achievements" aria-label="Achievements and Recognition" class="bg-gray-50 px-6 py-16 sm:px-8 md:px-16 md:py-20 lg:px-24 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-gray-500">
        Achievements
      </p>
      <h2 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">
        Impact delivered across teams, products, and performance goals
      </h2>
      <div class="mt-4 h-[5px] w-[75px] rounded-full" style={{ backgroundColor: siteConfig.accentColor }} />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((m) => (
        <div class="rounded-2xl border border-gray-200 bg-white p-5 text-center shadow-sm">
          <div class="text-3xl font-bold" style={{ color: siteConfig.accentColor }}>{m.value}</div>
          <div class="mt-2 text-sm text-gray-500">{m.label}</div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <h3 class="text-lg font-semibold uppercase tracking-widest text-gray-500">Awards & recognition</h3>
        <div class="mt-6 space-y-4">
          {awards.map((award) => (
            <div class="rounded-2xl border border-gray-100 bg-gray-50 p-5">
              <h4 class="text-base font-semibold text-gray-900">{award.title}</h4>
              <p class="mt-2 text-sm leading-7 text-gray-600">{award.description}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <h3 class="text-lg font-semibold uppercase tracking-widest text-gray-500">Core competencies</h3>
        <ul class="mt-6 space-y-3">
          {softSkills.map((skill) => (
            <li class="flex items-center gap-3 text-sm leading-7 text-gray-700 sm:text-base">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke={siteConfig.accentColor} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M5 12l5 5l10 -10" />
              </svg>
              <span>{skill}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
